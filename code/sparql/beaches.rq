PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
# Ink map: named beaches worldwide (instances of beach, Q40080, and its subclasses) with coordinates, Wikipedia sitelinks and English article. -> raw12/beaches.tsv
SELECT ?item ?label ?coord ?sl ?enwiki WHERE {
  ?item wdt:P31/wdt:P279* wd:Q40080 ; wdt:P625 ?coord ; wikibase:sitelinks ?sl .
  ?item rdfs:label ?label . FILTER (LANG(?label) = "en")
  OPTIONAL { ?enw schema:about ?item ; schema:isPartOf <https://en.wikipedia.org/> ; schema:name ?enwiki . }
}
